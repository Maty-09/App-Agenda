{
  "name": "norem",
  "version": 2,
  "builds": [
    {
      "src": "app/static/norem-logo.png",
      "use": "@vercel/static"
    },
    {
      "src": "app/main.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "^/static/norem-logo\\.png$",
      "dest": "/app/static/norem-logo.png"
    },
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "crons": [{"path": "/api/v1/cron/pruebas-vencidas", "schedule": "0 13 * * *"}]
}
