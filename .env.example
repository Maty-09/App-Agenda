# Plantilla segura: reemplaza los marcadores localmente; no copies valores reales al repositorio.

# Base de datos y autenticación (obligatorias)
DATABASE_URL=
JWT_SECRET_KEY=

# API de IA (opcional)
INCEPTION_API_KEY=

# Correo transaccional: usa Resend o relay SMTP
EMAIL_SENDER=no-reply@tu-dominio.cl
EMAIL_REPLY_TO=soporte@tu-dominio.cl
RESEND_API_KEY=
SMTP_HOST=mail.tu-dominio.cl
SMTP_PORT=465
SMTP_TIMEOUT_SECONDS=15
EMAIL_PASSWORD=
EMAIL_TOKEN=
EMAIL_ADMIN=admin@tu-dominio.cl

# URL pública de la aplicación
SYSTEM_BASE_URL=http://localhost:8000

# Suscripciones
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_NOREM_MENSUAL=

# Genera y configura un valor aleatorio largo fuera del repositorio.
CRON_SECRET=

# Logo para correos
LOGO_URL=https://norem.cl
